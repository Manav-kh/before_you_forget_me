# npm run setup creates a local random administrator and .local/admin-access.txt.
STOREFRONT_ORIGIN=http://127.0.0.1:3000
ADMIN_ORIGIN=http://127.0.0.1:3001
VITE_STOREFRONT_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
# Required for production; local development uses persistent embedded PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/byfm
# Configure production storage and backups before deployment.
# Production setup requires ADMIN_EMAIL and ADMIN_PASSWORD (16+ characters).
# Fresh production starts without example editions/posts and with ordering paused.
# SEED_PREVIEW_DATA=1 explicitly opts into example prices/stock/content.
# Set TRUST_PROXY=1 only behind a proxy that strips/replaces forwarded IP headers.
# TRUST_PROXY=0
# API_INTERNAL_URL=http://127.0.0.1:3000
